{
  "name": "next.js-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build -d",
    "dev": "next dev --port 4001 --turbopack",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "next-lint": "next lint",
    "start": "next start --port 4001",
    "test": "vitest run",
    "lint-staged-files": "lint-staged --allow-empty",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "Chrome 118",
      "last 1 chrome version",
      "last 1 edge version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@apollo/client": "4.1.2",
    "@apollo/client-integration-nextjs": "^0.14.4",
    "@bprogress/next": "^3.2.12",
    "@dimjs/utils": "^2.1.3",
    "@heroui/react": "^2.8.7",
    "@hookform/resolvers": "^5.2.2",
    "@hyperse/apollo-upload-client": "^1.0.1",
    "@hyperse/hero-tel-input": "^1.0.1",
    "@hyperse/logger": "^1.1.7",
    "@hyperse/logger-plugin-console": "^1.0.11",
    "@hyperse/next-config": "^1.0.7",
    "@hyperse/next-inspector": "^2.0.1",
    "@iconify/react": "^6.0.2",
    "@next/bundle-analyzer": "16.1.4",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "ahooks": "^3.9.6",
    "cookies-next": "6.1.1",
    "framer-motion": "^12.28.1",
    "gql.tada": "1.9.0",
    "graphql": "16.12.0",
    "jotai": "^2.16.2",
    "next": "16.1.4",
    "next-intl": "^4.7.0",
    "next-recaptcha-v3": "^1.5.3",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "simplebar-react": "^3.3.2",
    "stripe": "^20.2.0",
    "swr": "^2.3.8",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "1.15.2",
    "@changesets/cli": "2.29.8",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@hyperse/eslint-config-hyperse": "^1.5.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "commitizen": "4.3.1",
    "cross-env": "10.1.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "16.2.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "packageManager": "yarn@4.12.0"
}
